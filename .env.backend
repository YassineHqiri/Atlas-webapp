# =============================================================================
# SÉCURITÉ: Variables d'Environnement Backend
# =============================================================================
# IMPORTANT: Ce fichier contient les secrets. 
# NE PAS COMMITER dans le repository public!
# 
# En production, utiliser:
# - Docker Secrets
# - AWS Secrets Manager
# - HashiCorp Vault
# - Variables d'environnement du serveur
# =============================================================================

# Application Configuration
APP_KEY=base64:CHANGE_ME_TO_PRODUCTION_KEY_WITH_ARTISAN_KEY_GENERATE
APP_URL=https://atlascyber.viewdns.net
FRONTEND_URL=https://atlascyber.viewdns.net

# Database Configuration (AWS RDS)
DB_CONNECTION=mysql
DB_HOST=atlascommercial.c1u4ayqi0rzj.eu-north-1.rds.amazonaws.com
DB_PORT=3306
DB_DATABASE=atlascommercial
DB_USERNAME=CHANGE_ME_TO_SECURE_USERNAME
DB_PASSWORD=CHANGE_ME_TO_STRONG_PASSWORD_MIN_32CHARS

# Session Configuration
SESSION_DRIVER=database

# Cache Configuration
CACHE_DRIVER=file

# CORS Configuration
CORS_ALLOWED_ORIGINS=https://atlascyber.viewdns.net

# Sanctum Configuration
SANCTUM_STATEFUL_DOMAINS=atlascyber.viewdns.net

# Google reCAPTCHA v2 (REGENERATE IMMEDIATELY - old keys exposed)
RECAPTCHA_SITE_KEY=CHANGE_ME_TO_NEW_RECAPTCHA_KEY
RECAPTCHA_SECRET_KEY=CHANGE_ME_TO_NEW_RECAPTCHA_SECRET_KEY

# Security: Failed Authentication Attempts
MAX_LOGIN_ATTEMPTS=5
LOCKOUT_DURATION_MINUTES=15
FAILED_ATTEMPTS_TABLE=failed_authentication_attempts
