# =============================================================================
# SÉCURITÉ: .env.backend.example
# =============================================================================
# Ceci est un exemple de fichier de configuration
# Copier ce fichier en .env.backend et remplir avec les vraies valeurs
# 
# JAMAIS commiter le fichier .env.backend avec les vraies valeurs!
# =============================================================================

# Application Configuration
APP_KEY=base64:YOUR_GENERATED_KEY_HERE
APP_URL=https://yourdomain.com
FRONTEND_URL=https://yourdomain.com

# Database Configuration (AWS RDS)
DB_CONNECTION=mysql
DB_HOST=your-rds-instance.region.rds.amazonaws.com
DB_PORT=3306
DB_DATABASE=your_database_name
DB_USERNAME=secure_username
DB_PASSWORD=very_strong_password_minimum_32_characters_recommended

# Session Configuration
SESSION_DRIVER=database

# Cache Configuration
CACHE_DRIVER=file

# CORS Configuration (Specify your exact domain)
CORS_ALLOWED_ORIGINS=https://yourdomain.com,https://www.yourdomain.com

# Sanctum Configuration (Specify your exact domain)
SANCTUM_STATEFUL_DOMAINS=yourdomain.com,www.yourdomain.com

# Google reCAPTCHA v2 (https://www.google.com/recaptcha/admin)
RECAPTCHA_SITE_KEY=your_site_key_here
RECAPTCHA_SECRET_KEY=your_secret_key_here

# Security: Failed Authentication Attempts
MAX_LOGIN_ATTEMPTS=5
LOCKOUT_DURATION_MINUTES=15
FAILED_ATTEMPTS_TABLE=failed_authentication_attempts
